{
  "name": "zmiy — Python + tooling (nvim, python, node)",
  "build": {
    "dockerfile": "${localEnv:HOME}/pers/devcon/Dockerfile",
    "context": "${localEnv:HOME}"
  },
  "initializeCommand": "gpgconf --launch gpg-agent",
  "mounts": [
    "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind",
    "source=${localEnv:XDG_RUNTIME_DIR}/gnupg/S.gpg-agent.extra,target=/home/bchk/.gnupg/S.gpg-agent,type=bind",
    "source=${localEnv:HOME}/pers,target=/home/bchk/pers,type=bind",
    "source=${localEnv:HOME}/.gnupg/devcon-public.asc,target=/home/bchk/.gnupg/devcon-public.asc,type=bind",
    "source=devcon-nvim-data,target=/home/bchk/.local/share/nvim,type=volume"
  ],
  "remoteEnv": {
    "TMUX": "${localEnv:TMUX}"
  },
  "features": {
    "ghcr.io/bbchk/pers/helper:latest": {},
    "ghcr.io/devcontainers/features/common-utils:2": {
      "username": "bchk",
      "userUid": "1000",
      "userGid": "1000"
    },
    "ghcr.io/rocker-org/devcontainer-features/apt-packages:1": {
      "packages": "sudo,curl,git,make,gcc,g++,jq,gnupg,python3-pip,python3-venv,pipx,isort,cmake,pkg-config,meson,shellcheck,expect,xclip,libssl-dev,libreadline-dev,zlib1g-dev,libffi-dev,libgdbm-dev,lua5.4,luarocks,libarchive-tools,oathtool,fzf,tree,tmux,zsh,man-db,traceroute,ncat,dnsutils,net-tools,nmap,openfortivpn,fd-find,ripgrep,zip,unzip,lsof",
      "upgradePackages": "true"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {
      "installDirectlyFromGitHubRelease": true
    },
    "ghcr.io/devcontainers/features/python:1": {
      "toolsToInstall": "neovim-remote"
    },
    "ghcr.io/devcontainers/features/node:2": {
      "version": "26.3.1",
      "npmVersion": "11.17.0",
      "pnpmVersion": "11.5.3"
    },
    "ghcr.io/bbchk/pers/neovim:latest": {
      "version": "v0.11.5"
    }
  },
  "remoteUser": "bchk",
  "updateRemoteUserUID": true,
  "postCreateCommand": "/home/bchk/pers/devcon/postCreate.sh"
}
