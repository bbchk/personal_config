{
  "name": "devcon (base)",
  "build": {
    "dockerfile": "${localEnv:HOME}/pers/devcon/Dockerfile",
    "context": "${localEnv:HOME}"
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=${localWorkspaceFolder},type=bind",
  "workspaceFolder": "${localWorkspaceFolder}",
  "initializeCommand": "gpgconf --launch gpg-agent; xhost +SI:localuser:$(id -un) >/dev/null 2>&1 || true",
  "mounts": [
    "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind",
    "source=${localEnv:XDG_RUNTIME_DIR}/gnupg/S.gpg-agent.extra,target=/home/bchk/.gnupg/S.gpg-agent,type=bind",
    "source=${localEnv:HOME}/pers,target=/home/bchk/pers,type=bind",
    "source=${localEnv:HOME}/.gnupg/devcon-public.asc,target=/home/bchk/.gnupg/devcon-public.asc,type=bind",
    "source=devcon-nvim-data,target=/home/bchk/.local/share/nvim,type=volume",
    "source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind"
  ],
  "remoteEnv": {
    "DISPLAY": "${localEnv:DISPLAY}"
  },
  "features": {
    "ghcr.io/bbchk/pers/helper:latest": {},
    "ghcr.io/devcontainers/features/common-utils:2": {
      "username": "bchk",
      "userUid": "1000",
      "userGid": "1000",
      "installZsh": "true",
      "installOhMyZsh": "true",
      "configureZshAsDefaultShell": true
    },
    "ghcr.io/rocker-org/devcontainer-features/apt-packages:1": {
      "packages": "sudo,curl,git,make,gcc,g++,jq,gnupg,python3-pip,python3-venv,pipx,cmake,pkg-config,php-xdebug,rustfmt,isort,libre2-dev,libmysqlclient-dev,meson,shellcheck,expect,xclip,libssl-dev,libreadline-dev,zlib1g-dev,libyaml-dev,libffi-dev,libgdbm-dev,libncurses-dev,uuid-dev,libssh2-1-dev,libgit2-dev,ruby-dev,lua5.4,luarocks,libarchive-tools,oathtool,fzf,tree,tmux,zsh,man-db,traceroute,ncat,dnsutils,net-tools,nmap,openfortivpn,fd-find,ripgrep,zip,unzip,lsof,cppcheck",
      "upgradePackages": "true"
    },
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "version": "latest",
      "moby": false
    },
    "ghcr.io/bbchk/pers/neovim:latest": {
      "version": "v0.11.5"
    }
  },
  "remoteUser": "bchk",
  "updateRemoteUserUID": true,
  "postCreateCommand": "/home/bchk/pers/devcon/postCreate.sh"
}
