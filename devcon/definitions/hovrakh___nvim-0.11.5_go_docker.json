{
  "name": "hovrakh — Go backend (nvim, go, docker)",
  "build": {
    "dockerfile": "${localEnv:HOME}/pers/devcon/Dockerfile",
    "context": "${localEnv:HOME}"
  },
  "mounts": [
    "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind",
    "source=${localEnv:XDG_RUNTIME_DIR}/gnupg/S.gpg-agent.extra,target=/root/.gnupg/S.gpg-agent,type=bind",
    "source=${localEnv:HOME}/pers,target=/root/pers,type=bind",
    "source=${localEnv:HOME}/.gnupg/devcon-public.asc,target=/root/.gnupg/devcon-public.asc,type=bind"
  ],
  "remoteEnv": {
    "TMUX": "${localEnv:TMUX}"
  },
  "features": {
    "ghcr.io/bbchk/pers/helper:latest": {},
    "ghcr.io/devcontainers/features/common-utils:2": {},
    "ghcr.io/rocker-org/devcontainer-features/apt-packages:1": {
      "packages": "sudo,curl,git,make,gcc,g++,jq,gnupg,python3-pip,python3-venv,pipx,cmake,pkg-config,meson,shellcheck,expect,xclip,libssl-dev,libreadline-dev,zlib1g-dev,libffi-dev,lua5.4,luarocks,libarchive-tools,oathtool,fzf,tree,tmux,zsh,man-db,traceroute,ncat,dnsutils,net-tools,nmap,openfortivpn,fd-find,ripgrep,zip,unzip,lsof",
      "upgradePackages": "true"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {
      "installDirectlyFromGitHubRelease": true
    },
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "version": "latest",
      "moby": false
    },
    "ghcr.io/devcontainers/features/go:1": {
      "version": "latest"
    },
    "ghcr.io/bbchk/pers/neovim:latest": {
      "version": "v0.11.5"
    }
  },
  "postCreateCommand": "/root/pers/devcon/postCreate.sh"
}
