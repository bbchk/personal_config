#!/usr/bin/env bash

sudo -v || exit 1

regions=("east1" "east2" "west1" "west2" "global")
region=$(printf "%s\n" "${regions[@]}" | fzf --height=10 --border --prompt="Region?: ")

  # | fzf --height=25 --border --delimiter='/' --with-nth='4..' --prompt="Workdir?: ")

if [ -z "$region" ]; then
  echo "No region selected. Exiting."
  exit 1
fi

read -rp "OTP?: " one_time_password

config_file="$HOME/pers/secrets/vpn/credentials.cfg"
sudo openfortivpn "vpn-${region}.internetbrands.com:443" \
  -c "${config_file}" \
  -o "${one_time_password}" &
disown
