#!/usr/bin/env bash
# shellcheck disable=SC2155

source "$HOME/pers/scripts/utils"
source "$HOME/pers/scripts/hop_to_worktree"

get_all_refs() {
  {
    git for-each-ref refs/heads/ --format='%(refname:short)|branch'
    git for-each-ref refs/remotes/ --format='%(refname:short)|remote' | grep -v '/HEAD$'
    git for-each-ref refs/tags/ --format='%(refname:short)|tag'
  }
}

main() {
  if ! git rev-parse --git-dir >/dev/null 2>&1; then
    echo "Error: Not in a git repository" >&2
    return 1
  fi

  local all_refs_output=$(get_all_refs)
  local all_refs=()

  while IFS= read -r line; do
      all_refs+=("$line")
  done <<< "$all_refs_output"

  fzf_output=$(printf '%s\n' "${all_refs[@]}" | fzf --height=15 --print-query --border)

  local query selected_ref
  query=$(echo "$fzf_output" | head -n1)
  log "query: [$query]"

  selected_ref=$(echo "$fzf_output" | sed -n '2p')
  log "selected_ref: [$selected_ref]"

  if [[ -z "$selected_ref" && -z "$query" ]]; then
    echo "Operation cancelled"
    return 0
  fi

  local ref_name ref_type
  if [[ -n "$query" && -z "$selected_ref" ]]; then
      log "new branch: [$query]"
      ref_name="$query"
      ref_type="NEWBRANCH"
  else
      ref_type=$(echo "$selected_ref" | cut -d'|' -f2)
      ref_name=$(echo "$selected_ref" | cut -d'|' -f1)
  fi

  log "ref_type=[$ref_type]"
  log "ref_name=[$ref_name]"

  local git_common_dir
  git_common_dir=$(git rev-parse --git-common-dir)

  local worktree_name
  worktree_name=$(sed 's/\//_/g; s/[^a-zA-Z0-9._-]/-/g' <<<"${ref_name}")
  log "WORKTREE_NAME: $worktree_name"

  local absolute_worktree_path="${git_common_dir}/wk/${worktree_name}"
  log "ABSOLUTE_WORKTREE_PATH: $absolute_worktree_path"

  if [[ -e "$absolute_worktree_path" ]]; then
    log "Error: Path '$absolute_worktree_path' already exists"
    return 1
  fi

  case "$ref_type" in
  "branch")
    log "Creating branch"
    git worktree add "$absolute_worktree_path" "${ref_name}"
    ;;
  "remote")
    log "Creating remote"
    # TODO: implement remote handling if needed
    ;;
  "tag")
    log "Creating tag"
    git worktree add "$absolute_worktree_path" "${ref_name}"
    ;;
  "NEWBRANCH")
    log "Creating new branch"
    git worktree add "$absolute_worktree_path" -b "$ref_name" HEAD
    ;;
  esac

  cd "${absolute_worktree_path}" || log "cd failed"
}

main "$@"
