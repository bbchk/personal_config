#!/usr/bin/env bash
# shellcheck disable=SC2155

source ./utils

get_all_refs() {
  {
    git for-each-ref refs/heads/ --format='%(refname:short)|branch'
    git for-each-ref refs/remotes/ --format='%(refname:short)|remote' | grep -v '/HEAD$'
    git for-each-ref refs/tags/ --format='%(refname:short)|tag'
  }
}

main() {
  if ! git rev-parse --git-dir >/dev/null 2>&1; then
    echo "Error: Not in a git repository" >&2
    return 1
  fi

  local all_refs_output=$(get_all_refs)
  local all_refs=()

  while IFS= read -r line; do
      all_refs+=("$line")
  done <<< "$all_refs_output"

  fzf_output=$(printf '%s\n' "${all_refs[@]}" | fzf --height=15 --print-query --border)

  local query selected_ref
  query=$(echo "$fzf_output" | head -n1)
  echo "DEBUG: query: [$query]"

  selected_ref=$(echo "$fzf_output" | sed -n '2p')
  echo "DEBUG: selected_ref: [$selected_ref]"

  if [[ -z "$selected_ref" && -z "$query" ]]; then
    echo "Operation cancelled"
    return 0
  fi

  local ref_name ref_type
  if [[ -n "$query" && -z "$selected_ref" ]]; then
      echo "DEBUG: new branch: [$query]"
      ref_name="$query"
      ref_type="NEWBRANCH"
  else
      ref_type=$(echo "$selected_ref" | cut -d'|' -f2)
      ref_name=$(echo "$selected_ref" | cut -d'|' -f1)
  fi

  echo "DBG ref_type=[$ref_type]"
  echo "DBG ref_name=[$ref_name]"

  local git_common_dir=$(git rev-parse --git-common-dir)

  local worktree_name=$(sed 's/\//_/g; s/[^a-zA-Z0-9._-]/-/g' <<<"${ref_name}")
  echo "WORKTREE_NAME: $worktree_name"

  local absolute_worktree_path="${git_common_dir}/wk/${worktree_name}"
  echo "ABSOLUTE_WORKTREE_PATH: $absolute_worktree_path"

  if [[ -e "$absolute_worktree_path" ]]; then
    echo "Error: Path '$absolute_worktree_path' already exists"
    return 1
  fi

  case "$ref_type" in
  "branch")
    echo "Creating branch"
    git worktree add "$absolute_worktree_path" "${ref_name}"
    ;;
  "remote")
    echo "Creating remote"
    # TODO: No use case found yet
    # local branch_name=$(echo "$ref_name" | sed 's/.*\///')
    # git worktree add "$absolute_worktree_path" -b "$branch_name" "$ref_name"
    #
    # git worktree add "$absolute_worktree_path" -b "${ref_name}" "${ref_name}"
    ;;
  "tag")
    echo "Creating tag"
    git worktree add "$absolute_worktree_path" "${ref_name}"
    ;;
  "NEWBRANCH")
    echo "Creating new branch"
    # Create new branch on HEAD
    git worktree add "$absolute_worktree_path" -b "$ref_name" HEAD
    ;;
  esac
}

main "$@"

# implement forcing
#     -f, --[no-]force      checkout <branch> even if already checked out in other worktree
# -b <branch>           create a new branch
# -B <branch>           create or reset a branch
# -d, --[no-]detach     detach HEAD at named commit
