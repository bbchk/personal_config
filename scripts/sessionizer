#!/usr/bin/env bash

session=$(find ~ ~/dev ~/dev/ib ~/dev/my ~/dev/lw ~/pers/xdg -mindepth 1 -maxdepth 1 -type d ! -name '.*' | fzf --border --delimiter='/' --with-nth='4..' --prompt="Workdir?: ")

[ -z "$session" ] && exit 0

if ! tmux ls &>/dev/null; then
  tmux start-server
fi

session_name=$(echo "$session" | tr './' '_')
if ! tmux has-session -t "$session_name" 2>/dev/null; then

  LOCAL_DC_DIR="$session/.devcontainer"
  GLOBAL_DC_CONFIG="$HOME/pers/.devcontainer/devcontainer.json"

  if [ -d "$LOCAL_DC_DIR" ]; then
    CONFIG_FLAG=""
  elif [ -f "$GLOBAL_DC_CONFIG" ]; then
    CONFIG_FLAG="--config $GLOBAL_DC_CONFIG"
  fi

  tmux new-session -s "$session_name" -c "$session" -d
  tmux send-keys -t "$session_name" "exec BUILDKIT_PROGRESS=plain devcon up --workspace-folder . $CONFIG_FLAG --remove-existing-container --no-lockfile --log-level trace && devcon exec --workspace-folder . $CONFIG_FLAG 'nvim' '--cmd' 'lua vim.g.sessionizer_devcon = true'" C-m
fi

if [ -z "$TMUX" ]; then
  exec tmux attach-session -t "$session_name"
else
  tmux switch-client -t "$session_name"
fi

