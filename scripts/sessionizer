#!/usr/bin/env bash

# Any args passed to this script are forwarded to `devcontainer up`
# (e.g. --recreate-existing-container, --no-lockfile).
EXTRA_UP_ARGS="$*"

# The devcontainer CLI lives here. `devcon` is only a zsh alias, and this script
# may run outside an interactive shell (GNOME keybinding -> `kitty -e sessionizer`),
# so put the real binary on PATH and call it directly.
export PATH="$HOME/.devcontainers/bin:$PATH"

session=$(find ~/pers/devcon/definitions -mindepth 1 -maxdepth 1 -type f ! -name '.*' ! -name 'base.json' | fzf --border --delimiter='/' --with-nth='7..' --prompt="Devcon?: ")

[ -z "$session" ] && exit 0

# Then pick the folder to open by default in nvim (terminal tab + Oil tab).
# Options live under ~/dev on the host, which is mounted at /workspaces/dev
# inside the container, so translate the host path to its in-container path
# before handing it to nvim.
folder=$({ echo "$HOME/pers"; echo "$HOME/pers/xdg"; find ~/dev ~/pers -mindepth 1 -maxdepth 2 -type d ! -path '*/.*'; } | awk '!seen[$0]++' | fzf --border --delimiter='/' --with-nth='4..' --prompt="Folder?: ")

[ -z "$folder" ] && exit 0

container_folder="${folder/#$HOME\/dev//workspaces/dev}"

# Definitions "extend" base.json: base.json holds everything shared, and each
# persona file lists only its extra features. base.json is the actual devcontainer
# config; the persona's features are layered on via `up --additional-features`.
#
# Stable per-persona dir (not mktemp): the devcontainer.config_file label is part
# of the container identity, so copying base.json to a per-persona path keeps each
# persona's container separate and reusable across launches (~0.3s vs ~10-30s).
# Overwrite so edits to base.json still propagate; pass --remove-existing-container
# to force a fresh one.
dc_dir="${XDG_CACHE_HOME:-$HOME/.cache}/devcon/$(basename "$session" .json)"
mkdir -p "$dc_dir"
cp "$HOME/pers/devcon/definitions/base.json" "$dc_dir/devcontainer.json"
CONFIG_FLAG="--config $dc_dir/devcontainer.json"

# The persona's language/tool features, injected on top of base.json.
persona_features=$(jq -c '.features // {}' "$session")

# Bring the container up (reused if already running), then hand this kitty window
# straight to nvim inside it -- no tmux. If `up` fails, pause so the error stays
# readable before kitty closes the window.
if ! BUILDKIT_PROGRESS=plain devcontainer up --workspace-folder "$HOME/dev/" $CONFIG_FLAG --additional-features "$persona_features" $EXTRA_UP_ARGS --log-level trace; then
  echo
  echo "devcontainer up failed. Press Enter to close."
  read -r _
  exit 1
fi

# Force a TERM whose terminfo is guaranteed to exist in the container. `exec`
# forwards this shell's TERM, and kitty's own xterm-kitty has no terminfo inside
# the image -- which breaks split/redraw (mirroring) and Ctrl-hjkl decoding.
# xterm-256color is shipped by ncurses-base; nvim still probes kitty's keyboard
# protocol at runtime, so nothing is lost.
exec env TERM=xterm-256color devcontainer exec --workspace-folder "$HOME/dev" $CONFIG_FLAG \
  nvim --cmd "lua vim.g.sessionizer_devcon = true; vim.g.sessionizer_folder = \"$container_folder\""
