#!/usr/bin/env bash

# Any args passed to this script are forwarded to `devcon up`
# (e.g. --recreate-existing-container, --no-lockfile).
EXTRA_UP_ARGS="$*"

session=$(find ~/pers/devcon/definitions -mindepth 1 -maxdepth 1 -type f ! -name '.*' | fzf --border --delimiter='/' --with-nth='7..' --prompt="Devcon?: ")

[ -z "$session" ] && exit 0

# Then pick the folder to open by default in nvim (terminal tab + Oil tab).
# Options live under ~/dev on the host, which is mounted at /workspaces/dev
# inside the container, so translate the host path to its in-container path
# before handing it to nvim.
folder=$(find ~/dev -mindepth 1 -maxdepth 2 -type d ! -path '*/.*' | fzf --border --delimiter='/' --with-nth='5..' --prompt="Folder?: ")

[ -z "$folder" ] && exit 0

container_folder="${folder/#$HOME\/dev//workspaces/dev}"

if ! tmux ls &>/dev/null; then
  tmux start-server
fi

# $session is the picked definition file; use it as the devcontainer config.
# Stable per-persona dir (not mktemp): keeps the devcontainer.config_file label
# constant across launches so `devcon up` reuses the existing container instead
# of creating a new one every time (~0.3s vs ~10-30s). Overwrite so edits to the
# definition still propagate; pass --remove-existing-container to force a fresh one.
dc_dir="${XDG_CACHE_HOME:-$HOME/.cache}/devcon/$(basename "$session" .json)"
mkdir -p "$dc_dir"
cp "$session" "$dc_dir/devcontainer.json"
CONFIG_FLAG="--config $dc_dir/devcontainer.json"

config_label=$(basename "$session" | sed 's/___.*//' | tr -c 'a-zA-Z0-9_-' '_')

rand_num=$((RANDOM % 9000 + 1000))
session_name="${config_label}_${rand_num}"

if ! tmux has-session -t "$session_name" 2>/dev/null; then
  tmux new-session -s "$session_name" -c "$HOME/dev" -d
  tmux send-keys -t "$session_name" "BUILDKIT_PROGRESS=plain devcon up --workspace-folder $HOME/dev/ $CONFIG_FLAG $EXTRA_UP_ARGS --log-level trace && devcon exec --workspace-folder $HOME/dev $CONFIG_FLAG 'nvim' '--cmd' 'lua vim.g.sessionizer_devcon = true; vim.g.sessionizer_folder = \"$container_folder\"'" C-m
fi

if [ -z "$TMUX" ]; then
  exec tmux attach-session -t "$session_name"
else
  tmux switch-client -t "$session_name"
fi
