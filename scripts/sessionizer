#!/usr/bin/env bash

session=$(find ~/pers/devcon/definitions -mindepth 1 -maxdepth 1 -type f ! -name '.*' | fzf --border --delimiter='/' --with-nth='4..' --prompt="Devcon?: ")

[ -z "$session" ] && exit 0

if ! tmux ls &>/dev/null; then
  tmux start-server
fi

# $session is the picked definition file; use it as the devcontainer config.
CONFIG_FLAG="--config $session"
config_label=$(basename "$session" | sed 's/___.*//')

rand_num=$((RANDOM % 9000 + 1000))
session_name="${config_label}_${rand_num}"

if ! tmux has-session -t "$session_name" 2>/dev/null; then
  tmux new-session -s "$session_name" -c "$HOME/dev" -d
  tmux send-keys -t "$session_name" "BUILDKIT_PROGRESS=plain devcon up --workspace-folder $HOME/dev/ $CONFIG_FLAG --remove-existing-container --no-lockfile --log-level trace && devcon exec --workspace-folder $HOME/dev $CONFIG_FLAG 'nvim' '--cmd' 'lua vim.g.sessionizer_devcon = true'" C-m
fi

if [ -z "$TMUX" ]; then
  exec tmux attach-session -t "$session_name"
else
  tmux switch-client -t "$session_name"
fi
