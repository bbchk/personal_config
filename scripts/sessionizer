#!/usr/bin/env bash

# devcon up \
# --workspace-folder $PWD \
# --remove-existing-container \
# --log-level trace \
# --no-lockfile


# devcon exec --workspace-folder $PWD nvim

source "$HOME/pers/scripts/utils.sh"

main() {
  if ! tmux ls &>/dev/null; then
    log "No tmux server running, starting one..."
    tmux start-server
  fi

  session="${HOME}"
  tmux_session_name=$(echo "$session" | tr './' '_')
  log "Target session: $tmux_session_name"

  if ! tmux has-session -t "$tmux_session_name" 2>/dev/null; then
    log "Creating new tmux session: $tmux_session_name"
    tmux new-session -s "$tmux_session_name" -c "$session" -d "SESSIONIZER_START=true nvim"
  fi

  if [ -z "$TMUX" ]; then
    log "Attaching to session"
    tmux attach-session -t "$tmux_session_name"
  else
    log "Switching client to session"
    tmux switch-client -t "$tmux_session_name"
  fi
}

main "$@"
