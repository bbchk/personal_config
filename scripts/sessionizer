#!/usr/bin/env bash
# shellcheck disable=SC2155

main() {
  # Pick a directory interactively
  session=$(find ~ ~/dev -mindepth 1 -maxdepth 1 -type d ! -name '.*' \
    | fzf --height=80% --margin=25% --border=rounded \
    --prompt="Workdir?: " --delimiter='/' --with-nth='4..')

  [ -z "$session" ] && return 0

  cd "$session" || return 1

  if ! git rev-parse --git-dir >/dev/null 2>&1; then
    echo "Not a Git repository — opening normally."
    exec nvim \
      +terminal \
      +tabnew \
      +"lua require('oil').open(vim.loop.cwd())"
  fi

  # Check if repo is bare
  is_bare=$(git rev-parse --is-bare-repository 2>/dev/null)

  if [ "$is_bare" = "true" ]; then
    source "$HOME/pers/scripts/create_worktree"

    worktree=$(git worktree list --porcelain 2>/dev/null | awk '/worktree /{print $2}' | tail -n1)
    if [ -n "$worktree" ]; then
      cd "$worktree" || return 1
    else
      echo "Failed to locate a valid worktree."
      return 1
    fi
  fi

  nvim \
    +terminal \
    +tabnew \
    +"lua require('oil').open(vim.loop.cwd())" \
    +"Telescope find_files"
}

main "$@"
