#!/usr/bin/env bash

main() {
    if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        echo "Error: Not in a git repository" >&2
        return 1
    fi

    remove_worktree_interactive
}

remove_worktree_interactive() {
    local trees tree absolute_path

    # Get all worktree paths
    trees=$(git worktree list --porcelain | grep '^worktree ' | awk '{print $2}')

    if [[ -z "$trees" ]]; then
        echo "No worktrees found."
        return 0
    fi

    # Let user select worktree
    tree=$(echo "$trees" | fzf --height=15 --border --prompt="Select worktree to remove: ")

    if [[ -z "$tree" ]]; then
        echo "No worktree selected."
        return 0
    fi

    absolute_path=$(realpath "$tree")

    echo "You selected: $absolute_path"
    read -r -p "Are you sure you want to remove this worktree? [y/N]: " confirm
    if [[ "$confirm" =~ ^[Yy]$ ]]; then
        # Use -f to force removal if necessary
        git worktree remove -f "$absolute_path"
        echo "Worktree removed: $absolute_path"
    else
        echo "Operation cancelled."
    fi
}

main "$@"
