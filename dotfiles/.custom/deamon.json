{
  "builder": {
    "gc": {
      "enabled": true,
      "defaultKeepStorage": "20GB",
      "policy": [
        { "keepStorage": "10GB", "filter": ["unused-for=2200h"] },
        { "keepStorage": "50GB", "filter": ["unused-for=3300h"] },
        { "keepStorage": "100GB", "all": true }
      ]
    }
  },
  "default-address-pools": [
    {
      "base": "192.168.50.0/22",
      "size": 24
    },
    {
      "base": "192.168.200.0/22",
      "size": 24
    },
    {
      "base": "172.20.0.0/16",
      "size": 24
    },
    {
      "base": "173.20.0.0/16",
      "size": 24
    }
  ]
}
