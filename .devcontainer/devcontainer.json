{
  "name": "nvim Container",
  "build": {
    "dockerfile": "../devcon/Dockerfile",
    "context": "${localEnv:HOME}"
  },
  "mounts": [
    "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind",
    "source=${localEnv:SSH_AUTH_SOCK},target=/run/host-gpg-agent.sock,type=bind",
    "source=${localEnv:XDG_RUNTIME_DIR}/gnupg/S.gpg-agent.extra,target=/root/.gnupg/S.gpg-agent,type=bind"
  ],
