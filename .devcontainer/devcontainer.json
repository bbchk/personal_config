{
  "name": "nvim Container",
  "build": {
    "dockerfile": "../devcon/Dockerfile",
    "context": "${localEnv:HOME}"
  },
  "mounts": [
    "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind"
  ],
  "features": {
   "ghcr.io/devcontainers/features/github-cli:1": {
      "installDirectlyFromGitHubRelease": true
    },

    "ghcr.io/devcontainers/features/go:1": {},
    "ghcr.io/devcontainers/features/php:1": {},
    "ghcr.io/devcontainers/features/python:1": {},

    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "moby": false
    },

    "ghcr.io/bbchk/pers/helper:latest": {},
    "ghcr.io/bbchk/pers/base:latest": {},
    "ghcr.io/bbchk/pers/dotfiles:latest": {},

    "ghcr.io/bbchk/pers/nvm:latest": {},

    "ghcr.io/bbchk/pers/neovim:latest": {
      "version": "v0.11.5"
    }
  },
  "postCreateCommand": "/root/pers/scripts/setup/devcon.sh"
}
