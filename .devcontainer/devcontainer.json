{
  "name": "nvim Container",
  "build": {
    "dockerfile": "../devcon/Dockerfile",
    "context": "${localEnv:HOME}"
  },
  "mounts": [
    "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind"
  ],
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {
      "installDirectlyFromGitHubRelease": true
    },

    "ghcr.io/devcontainers/features/go:1": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/php:1": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/python:1": {},
    "ghcr.io/devcontainers/features/node:2": {
      "version": "26.3.1",
      "npmVersion": "11.17.0",
      "pnpmVersion": "11.5.3"
    },
    "ghcr.io/devcontainers/features/ruby:2": {
      "version": "latest",
      "versionManager": "rbenv"
    },
    "ghcr.io/devcontainers/features/java:1": {
      "version": "latest",
      "additionalVersions": "",
      "jdkDistro": "ms",
      "installMaven": true,
      "mavenVersion": "latest",
      "installGradle": false,
      "installGroovy": false,
      "groovyVersion": "latest"
    },

    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "version": "latest",
      "moby": false
    },

    "ghcr.io/bbchk/pers/helper:latest": {},
    "ghcr.io/bbchk/pers/base:latest": {},
    "ghcr.io/bbchk/pers/dotfiles:latest": {},

    "ghcr.io/bbchk/pers/neovim:latest": {
      "version": "v0.11.5"
    }
  }
}
