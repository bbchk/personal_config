#!/usr/bin/env bash

COMMIT_MSG_FILE="$1"
COMMIT_SOURCE="$2"

# Only execute for interactive editor mode (empty source) or template-based commits
[[ -n "$COMMIT_SOURCE" && "$COMMIT_SOURCE" != "template" ]] && exit 0

branch=$(git symbolic-ref --short HEAD 2>/dev/null) || exit 0

# Extract only the first matching ticket reference from the branch name
ticket=$(grep -oE 'PORT-[0-9]+|PLTF-[0-9]+|DF-[0-9]+|HOP-[0-9]+' <<<"$branch" | head -n 1)

[[ -z "$ticket" ]] && exit 0

# Editor mode: insert the single ticket on the first line without a trailing newline
{
  echo -n "$ticket: "
  # Use sed to strip any initial empty lines from the original git template
  sed '/./,$!d' "$COMMIT_MSG_FILE"
} >"$COMMIT_MSG_FILE.tmp" && mv "$COMMIT_MSG_FILE.tmp" "$COMMIT_MSG_FILE"
