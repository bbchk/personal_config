#!/usr/bin/env bash

set -euo pipefail

echo "======= pre-commit started ======="

# Verify GPG filters are configured
if ! git config --get filter.gpg.clean >/dev/null 2>&1; then
  echo "ERROR: GPG filters not configured. Run: ./scripts/setup-git-filters"
  exit 1
fi

echo "GPG filters active. Secrets will be encrypted automatically."
echo -e "======= pre-commit finished =======\n"
