#!/usr/bin/env bash

set -euo pipefail

# Skip in repos without GPG filter configured
git config --get filter.gpg.clean >/dev/null 2>&1 || exit 0

# Skip if no .gitattributes with filter=gpg
repo_root=$(git rev-parse --show-toplevel)
grep -q 'filter=gpg' "$repo_root/.gitattributes" 2>/dev/null || exit 0

echo ""
echo -e "  \033[1;33m⚙  pre-commit\033[0m"
echo -e "  \033[0;32m🔐 GPG filters active — secrets will be encrypted automatically.\033[0m"
echo ""
