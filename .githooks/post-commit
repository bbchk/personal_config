#!/usr/bin/env bash

# Skip in repos without GPG filter configured
git config --get filter.gpg.clean >/dev/null 2>&1 || exit 0

echo ""
echo -e "  \033[1;33m⚙  post-commit\033[0m  verifying encryption..."

# Check only files that have filter=gpg attribute
failed=()
while IFS= read -r file; do
  [[ -z "$file" ]] && continue
  header=$(git cat-file blob HEAD:"$file" 2>/dev/null | head -c 30)
  header_hex=$(printf '%s' "$header" | od -A n -t x1 -N 1 | tr -d ' ')
  if [[ "$header_hex" == "84" || "$header_hex" == "85" || "$header" == *"BEGIN PGP MESSAGE"* ]]; then
    echo -e "     \033[0;32m✓\033[0m $file"
  else
    echo -e "     \033[0;31m✗ PLAINTEXT\033[0m $file"
    failed+=("$file")
  fi
done < <(git ls-tree -r --name-only HEAD | while read -r f; do
  attr=$(git check-attr filter -- "$f" 2>/dev/null)
  [[ "$attr" == *"filter: gpg"* ]] && echo "$f"
done)

if [[ ${#failed[@]} -gt 0 ]]; then
  echo ""
  echo -e "  \033[1;31m✗ ${#failed[@]} secret(s) NOT encrypted!\033[0m"
  echo -e "  \033[0;33m  Fix: git add the affected files && git commit --amend\033[0m"
  exit 1
fi

echo -e "  \033[0;32m✓ all secrets encrypted\033[0m"
echo ""
