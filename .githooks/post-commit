#!/usr/bin/env bash

# set -euo pipefail

# ====================================

main() {
  echo "======= post-commit started ======="

 local FILES_TO_DECRYPT=()

  if [[ "${1:-}" == "--all" ]]; then
    FILES_TO_DECRYPT=($(find secrets/ -type f))
  else
    FILES_TO_DECRYPT=($(git show --name-only --format= --diff-filter=d HEAD -- secrets/))
  fi

  if [ "${#FILES_TO_DECRYPT[@]}" -eq 0 ]; then

    echo "No secrets added to commit."
    echo "Skipping post-commit hook decryption"

  else

    PASSWORD_FILE="$HOME/pers/password"
    if [ ! -s "${PASSWORD_FILE}" ]; then
      echo "${PASSWORD_FILE} missing. Created now."
      echo "Enter correct password in the file and try again"
      touch "${PASSWORD_FILE}" && chmod 600 "${PASSWORD_FILE}"
      exit 1
    fi

    echo "Files to be decrypted:"
    for file in "${FILES_TO_DECRYPT[@]}"; do
        echo "  - $file"
    done

    echo "Decryption..."
    ansible-vault decrypt --vault-password-file "${PASSWORD_FILE}" -- "${FILES_TO_DECRYPT[@]}"

    trap 'shred -u -n 5 "${PASSWORD_FILE}"' EXIT SIGINT SIGTERM

  fi

  echo -e "======= post-commit finished =======\n"
}

main "$@"
