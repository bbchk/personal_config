#!/usr/bin/env bash

# Skip in repos without GPG filter configured
git config --get filter.gpg.clean >/dev/null 2>&1 || exit 0

repo_root=$(git rev-parse --show-toplevel)

# Extract path patterns with filter=gpg from .gitattributes
gpg_patterns=()
while IFS= read -r line; do
  pattern=$(echo "$line" | awk '{print $1}')
  [[ -n "$pattern" ]] && gpg_patterns+=("$pattern")
done < <(grep 'filter=gpg' "$repo_root/.gitattributes" 2>/dev/null)

# Skip if no GPG-filtered paths
[[ ${#gpg_patterns[@]} -eq 0 ]] && exit 0

echo ""
echo -e "  \033[1;33m⚙  post-commit\033[0m  verifying encryption..."

# Convert glob patterns to directory prefixes for git ls-tree
ls_tree_paths=()
for p in "${gpg_patterns[@]}"; do
  dir=${p%%\*\**}
  [[ -z "$dir" ]] && dir="."
  ls_tree_paths+=("$dir")
done

# Verify all matched files in HEAD are encrypted (GPG binary starts with 0x84 or 0x85)
failed=()
for file in $(git ls-tree -r --name-only HEAD -- "${ls_tree_paths[@]}" 2>/dev/null); do
  [[ -z "$file" ]] && continue
  header=$(git cat-file blob HEAD:"$file" 2>/dev/null | od -A n -t x1 -N 1 | tr -d ' ')
  if [[ "$header" == "84" || "$header" == "85" ]]; then
    echo -e "     \033[0;32m✓\033[0m $file"
  else
    echo -e "     \033[0;31m✗ PLAINTEXT\033[0m $file"
    failed+=("$file")
  fi
done

if [[ ${#failed[@]} -gt 0 ]]; then
  echo ""
  echo -e "  \033[1;31m✗ ${#failed[@]} secret(s) NOT encrypted!\033[0m"
  echo -e "  \033[0;33m  Fix: git add the affected files && git commit --amend\033[0m"
  exit 1
fi

echo -e "  \033[0;32m✓ all secrets encrypted\033[0m"
echo ""
